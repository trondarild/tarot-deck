  <!-- Major Arcana -->
  <card id="00"><title>Блазень</title><description><p>Початок шляху, невинність, потенціал.</p></description></card>
  <card id="01"><title>Маг</title><description><p>Майстерність, ініціатива, свідомість.</p></description></card>
  <card id="02"><title>Верховна Жриця</title><description><p>Інтуїція, підсвідомість, таємниця.</p></description></card>
  <card id="03"><title>Імператриця</title><description><p>Родючість, природа, достаток.</p></description></card>
  <card id="04"><title>Імператор</title><description><p>Структура, влада, стабільність.</p></description></card>
  <card id="05"><title>Ієрофант</title><description><p>Традиції, навчання, духовний авторитет.</p></description></card>
  <card id="06"><title>Закохані</title><description><p>Вибір, союз, гармонія.</p></description></card>
  <card id="07"><title>Колісниця</title><description><p>Контроль, воля, тріумф.</p></description></card>
  <card id="08"><title>Сила</title><description><p>Мужність, м'яка сила, терпіння.</p></description></card>
  <card id="09"><title>Самітник</title><description><p>Пошук істини, самотність, мудрість.</p></description></card>
  <card id="10"><title>Колесо Фортуни</title><description><p>Цикли, доля, зміни.</p></description></card>
  <card id="11"><title>Справедливість</title><description><p>Баланс, правда, закон.</p></description></card>
  <card id="12"><title>Повішений</title><description><p>Жертва, зміна перспективи, пауза.</p></description></card>
  <card id="13"><title>Смерть</title><description><p>Трансформація, кінець та початок.</p></description></card>
  <card id="14"><title>Помірність</title><description><p>Гармонія, баланс, зцілення.</p></description></card>
  <card id="15"><title>Диявол</title><description><p>Пристрасть, залежність, матеріалізм.</p></description></card>
  <card id="16"><title>Вежа</title><description><p>Раптові зміни, руйнування ілюзій.</p></description></card>
  <card id="17"><title>Зірка</title><description><p>Надія, натхнення, спокій.</p></description></card>
  <card id="18"><title>Місяць</title><description><p>Мрії, ілюзії, інтуїція.</p></description></card>
  <card id="19"><title>Сонце</title><description><p>Успіх, радість, життєва сила.</p></description></card>
  <card id="20"><title>Суд</title><description><p>Відродження, заклик, прощення.</p></description></card>
  <card id="21"><title>Світ</title><description><p>Завершення, інтеграція, подорож.</p></description></card>

